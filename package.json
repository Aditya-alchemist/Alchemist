{
  "name": "alchemist",
  "version": "0.1.0",
  "description": "A voice-first personal AI assistant for Windows",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "alchemist": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-ui.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "alchemist",
    "ai-assistant",
    "voice-assistant",
    "openrouter",
    "windows"
  ],
  "license": "MIT",
  "dependencies": {
    "@openrouter/sdk": "^1.4.25",
    "dotenv": "^18.0.7",
    "electron": "^44.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@44.7.1": true
  }
}